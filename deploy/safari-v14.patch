+async function fetchStaffGmailStatus({ rerender = true } = {}) {
+  try {
+    const response = await fetch(
+      `${STAFF_BINDING_API_URL}/rest/v1/rpc/get_staff_gmail_status`,
+      {
+        method: "POST",
+        headers: {
+          "apikey": STAFF_BINDING_API_KEY,
+          "Content-Type": "application/json"
+        },
+        body: "{}",
+        cache: "no-store"
+      }
+    );
+
+    if (!response.ok) throw new Error(`Status ${response.status}`);
+    const rows = await response.json();
+
+    staffBindingStatus = {};
+    for (const row of rows || []) {
+      staffBindingStatus[row.profile_id] = Boolean(row.linked);
+    }
+    staffBindingStatusLoaded = true;
+
+    if (rerender && staffGate.classList.contains("visible") &&
+        !staffLoginPanel.classList.contains("visible")) {
+      renderStaffProfiles();
+    }
+
+    if (selectedStaffId && staffLoginPanel.classList.contains("visible")) {
+      updateSelectedStaffBindingUI();
+    }
+  } catch (error) {
+    console.warn("No se pudo consultar la vinculación de Gmail:", error);
+    staffBindingStatusLoaded = false;
+    if (selectedStaffId && staffLoginPanel.classList.contains("visible")) {
+      staffBindingLive.classList.remove("linked");
+      staffBindingLive.classList.add("unknown");
+      staffBindingLiveText.textContent = "NO SE PUDO VERIFICAR EL ESTADO";
+    }
+  }
+}
+
+async function claimStaffGmail(profileId, email) {
+  const response = await fetch(
+    `${STAFF_BINDING_API_URL}/rest/v1/rpc/claim_staff_gmail`,
+    {
+      method: "POST",
+      headers: {
+        "apikey": STAFF_BINDING_API_KEY,
+        "Content-Type": "application/json"
+      },
+      body: JSON.stringify({
+        p_profile_id: profileId,
+        p_email: email
+      }),
+      cache: "no-store"
+    }
+  );
+
+  if (!response.ok) {
+    throw new Error(`No se pudo validar el Gmail (${response.status}).`);
+  }
+
+  return await response.json();
+}
+
+function bindingLabelFor(profileId) {
+  if (!staffBindingStatusLoaded) return "VERIFICANDO…";
+  return staffBindingStatus[profileId] ? "GMAIL VINCULADO" : "SIN VINCULAR";
+}
+
+function updateSelectedStaffBindingUI() {
+  if (!selectedStaffId) return;
+  const linked = Boolean(staffBindingStatus[selectedStaffId]);
+
+  staffBindingLive.classList.toggle("linked", staffBindingStatusLoaded && linked);
+  staffBindingLive.classList.toggle("unlinked", staffBindingStatusLoaded && !linked);
+  staffBindingLive.classList.toggle("unknown", !staffBindingStatusLoaded);
+
+  if (!staffBindingStatusLoaded) {
+    staffBindingLiveText.textContent = "CONSULTANDO VINCULACIÓN…";
+    staffLoginHelp.textContent =
+      "Estamos verificando si este perfil ya tiene un Gmail vinculado.";
+    return;
+  }
+
+  if (linked) {
+    staffBindingLiveText.textContent = "GMAIL VINCULADO";
+    staffLoginHelp.textContent =
+      "Este perfil ya está vinculado. Ingresá exactamente el mismo Gmail para continuar.";
+  } else {
+    staffBindingLiveText.textContent = "PRIMER INGRESO · SIN VINCULAR";
+    staffLoginHelp.textContent =
+      "El primer Gmail válido que ingrese correctamente quedará vinculado a este perfil para todos los dispositivos.";
+  }
+}
